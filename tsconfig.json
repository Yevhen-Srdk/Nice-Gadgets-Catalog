{
  "extends": "@mate-academy/students-ts-config",
  "include": [
    "src"
  ],
  "compilerOptions": {
    "sourceMap": false,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@styles/*": ["src/styles/*"],
      "@utils/*": ["src/utils/*"],
      "@type/*": ["src/types/*"],
      "@shared/*": ["src/modules/shared/*"],
      "@hooks/*": ["src/hooks/*"],
      "@context/*": ["src/context/*"]
    }
  }
}
